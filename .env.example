# Copy to .env and fill in. .env is gitignored. On Dokploy, paste these into the app's Environment tab.

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Auth (single user, created on first start if no users exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# COOKIE_SECURE is set by the compose files (true in production, false locally): leave it out of here.

# --- Offline mode ---
# true = fake transcription / translation / LLM: the whole pipeline runs, no network, no cost.
# Handy to try the app, or when OpenRouter credit runs out.
AI_STUB=false

# --- External APIs ---
OPENROUTER_API_KEY=
# Translation runs on the OpenRouter models by default; TRANSLATOR=deepl uses DeepL instead.
TRANSLATOR=llm
DEEPL_API_KEY=
# Live subtitles (the Live page): OpenAI realtime transcription.
OPENAI_API_KEY=

# --- Cloudflare R2 (object storage for recordings and generated audio) ---
# Cloudflare dashboard -> R2 -> create a bucket, then "Manage R2 API Tokens" ->
# create a token with "Object Read & Write" scoped to that bucket.
# Leave these empty to store files under backend/data/ instead (local dev).
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=audimax
